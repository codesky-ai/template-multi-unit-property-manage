# إعدادات قاعدة البيانات - Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=property_management_db

# إعدادات الخادم - Server Configuration
PORT=3001
NODE_ENV=development

# إعدادات الأمان - Security Configuration
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# إعدادات CORS - CORS Configuration
FRONTEND_URL=http://localhost:5173

# إعدادات البريد الإلكتروني - Email Configuration (اختياري)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password

# إعدادات التخزين - Storage Configuration (اختياري)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10MB

# إعدادات أخرى - Other Settings
TIMEZONE=Asia/Riyadh
LOCALE=ar-SA